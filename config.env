# RevSight IQ: the ONE file to edit when you deploy to your own workspace.
# Every script in scripts/ reads this file. The values below are the reference
# demo (Databricks FE sandbox); change each line marked CHANGE ME.

# Databricks CLI profile from ~/.databrickscfg that points at your workspace.  CHANGE ME
DATABRICKS_PROFILE=DEFAULT

# Name of the Databricks App (lowercase letters, numbers, dashes; unique per workspace).  CHANGE ME
APP_NAME=wyndham-revsight

# Unity Catalog location for the demo tables and metric views.  CHANGE ME
# You need USE CATALOG on the catalog and USE SCHEMA, CREATE TABLE on the schema.
# The schema must already exist; scripts never create catalogs or schemas.
UC_CATALOG=jdub_demo
UC_SCHEMA=wyndham

# SQL warehouse ID (SQL Warehouses > your warehouse > Connection details).  CHANGE ME
# Serverless is recommended: building the 556M-row reservation table takes minutes.
WAREHOUSE_ID=c02d7ad10080ab8d

# Genie space IDs. workspace_deploy (notebook) creates the spaces and writes their IDs here for you.
# From a laptop: run scripts/create_genie_spaces.sh, then paste the two IDs it prints.  CHANGE ME
GENIE_SPACE_NT=01f1c1f3a12c135681e35099eb87cb2a
GENIE_SPACE_STR=01f1c1f3a21d1a338438c5a06ca2573b

# Optional: first day of demo history. 2019-01-01 builds the full demo (556M reservations).
# A later start builds faster on a small warehouse; keep it on or before 2025-09-01 so the
# year-over-year demo questions (September 2026 vs September 2025) still have data.
DATA_START=2019-01-01

# Optional: workspace folders for the app source and the Genie spaces.
# Empty means /Workspace/Users/<you>/apps/<APP_NAME> and /Workspace/Users/<you>/genie_spaces.
WORKSPACE_APP_PATH=
GENIE_PARENT_PATH=
